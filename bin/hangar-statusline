#!/bin/sh
# Status line for a hangar-root session, reached BY NAME so no settings file needs a home path.
#
# `.claude/modes/{ops,dev}.settings.json` are tracked -- they are operator mode's permission
# boundary, and generating them would let operator mode rewrite its own boundary through the
# `hangar doctor` it is allowed to run. So their one machine-specific line had to stop being
# machine-specific instead. They now say `hangar-statusline ops`, and this resolves the rest.
#
# Why a name on PATH is safe here, when the clone hooks deliberately refuse the same assumption:
# `bin/hangar-statusline` is reachable only because direnv ran `PATH_add bin` -- and so is
# `bin/hangar`. A session in a mode was started by a `hangar claude` found the same way, so direnv
# having loaded is ENTAILED by the mode existing at all, not assumed. A clone's SessionStart hook
# has no such guarantee, which is why `bin/hangar --hangar <root>` stays absolute there.
#
# Two probes that could NOT settle this, recorded so nobody repeats them:
#   - the status line does not run under `claude -p`, so it cannot be exercised from a script;
#   - `$CLAUDE_PROJECT_DIR` is NOT exported to tool subprocesses (checked: unset, while
#     CLAUDECODE, CLAUDE_CODE_ENTRYPOINT and friends are set), so it is hook-scoped and was never
#     a candidate for a settings file.
# Verify the way a human can: run `claude` at the hangar root, look for the badge in each tab.
#
# Resolved from this script's own location and never from $PWD -- the rule bin/hangar follows
# too, and what makes this work from any directory in the hangar.
set -eu

hangar="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
exec "$hangar/.claude/modes/statusline.sh" "$@"
