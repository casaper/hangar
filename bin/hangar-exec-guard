#!/usr/bin/env node
/*
 * PreToolUse guard: `hangar exec` is the human's, and no agent may run it.
 *
 * `hangar exec` hands an arbitrary shell snippet to every clone at once. That is a fine thing
 * for the person at the keyboard and the wrong thing for an agent, for two reasons that are
 * different in kind: it reaches every sibling's live working tree in one call, which is the
 * rule the fleet's own CLAUDE.md is built around; and it is a general-purpose escape from every
 * OTHER rule, since anything denied directly can be spelled as a snippet.
 *
 * **Why a hook and not just a deny rule.** A `Bash(hangar exec:*)` entry matches the literal
 * prefix of the command string, so `cd /somewhere && hangar exec ...` does not match it and
 * runs. The permission rules are still there -- being told "no" by a rule is a clearer answer
 * than being told by a hook -- but this is the half that actually holds, because it sees the
 * whole command line rather than its first token.
 *
 * **Self-contained, and deliberately not part of the CLI.** This runs before EVERY Bash tool
 * call in every clone and both hangar-root modes. Loading `app/src/cli.ts` costs ~0.25s of type
 * stripping; this file is a few hundred bytes of plain JS and costs a bare node start. It is
 * also the reason it cannot import the CLI's own helpers: a guard that fails to load is a guard
 * that is not guarding.
 *
 * **It fails CLOSED on a command it cannot read, and OPEN on a payload it cannot parse.** Those
 * are not in tension: an unparseable payload is Claude Code changing shape, where blocking every
 * Bash call in the fleet would be far worse than the thing being guarded; an unreadable COMMAND
 * inside a well-formed payload is the case somebody is trying to hide something.
 */

let raw = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => (raw += chunk));
process.stdin.on('end', () => {
  let payload;
  try {
    payload = JSON.parse(raw);
  } catch {
    process.exit(0); // Fail open: see the header.
  }
  if (payload?.tool_name !== 'Bash') process.exit(0);
  const command = payload?.tool_input?.command;
  if (typeof command !== 'string' || command === '') {
    deny(
      'This Bash call carries no command string the guard can read, so it is refused rather ' +
        'than waved through: the guard cannot tell what it would run.',
    );
    return;
  }

  const reason = invokesHangarExec(command)
    ? '`hangar exec` runs a shell snippet in every clone you name, and is reserved for the ' +
      'user at a terminal — it reaches other agents’ live working trees, and it can ' +
      'spell any command that is denied on its own. Ask the user to run it, and give them ' +
      'the exact line. `hangar exec -n` prints the plan and is also theirs, not yours. To ' +
      'act on ONE clone you may already have a permitted command for, use that instead.'
    : publishes(command)
      ? '**Publishing is the user’s, and no agent may do it — there is no exception to this.** ' +
        'Not `push`, not `--force`, not `--force-with-lease`, not `send-pack`, not through an ' +
        'alias, a script, a `--exec`, a release, or a pull request opened from the command line ' +
        '(`gh pr`, `gh api`, `hangar pr`). This holds ' +
        'however reasonable the push looks, and it holds especially right after a local history ' +
        'rewrite — a rewritten branch has diverged from its remote, and that is exactly when a ' +
        'force-push starts to feel necessary. Say the branch is ready, give the exact line, stop.'
      : actsThroughKey(command)
        ? 'This is the far end of a hangar key: the person presses it, and the palette entry runs. ' +
          'Run by an agent, `key pr` opens or rewrites a pull request, `key bg` starts a second ' +
          'headless Claude Code in a clone, and `key palette --entry` runs either -- each is ' +
          'the user’s. Name the entry and let them choose it from C-b P or VS Code. ' +
          '`hangar key pr -n` and `key palette --list` are let through.'
        : undefined;

  if (reason === undefined) process.exit(0);
  deny(reason);
});

function deny(reason) {
  process.stdout.write(
    JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'deny',
        permissionDecisionReason: reason,
      },
    }) + '\n',
  );
}

/**
 * Does this command line publish anything?
 *
 * **Why the guard's remit widened.** A managed repo may forbid pushing in its own rules -- this
 * fleet's does -- but that rule is one repo's, in a tracked file, and it only applies once that
 * repo's hooks are wired. Hangar manages any repo, and this instruction is not per-project:
 * publishing is the user's duty, always. A fresh clone, a repo with no such rule, and a rules
 * file that changes tomorrow all have to land the same way.
 *
 * **It is here NOW because of `bin/hangar-rewrite`.** That tool makes rewriting unpublished
 * history easy and refuses to touch published history -- but a rewritten branch has diverged from
 * its remote, and a diverged branch is the one situation where a force-push looks like the
 * obvious next step. The capability and this refusal were one decision, and splitting them up
 * later would leave the capability without its counterweight.
 *
 * Token-based for `invokesHangarExec`'s reasons: `git log --grep=push` and a file named `push.ts`
 * must survive, while `cd /x && git -C y push --force` must not.
 */
function publishes(command) {
  const tokens = command.split(/[\s;&|()`]+/).filter(Boolean);
  const bare = (t) => t.replace(/^["']|["']$/g, '');
  for (let i = 0; i < tokens.length; i += 1) {
    const token = bare(tokens[i]);
    if (/(^|\/)git$/.test(token)) {
      for (let j = i + 1; j < tokens.length; j += 1) {
        const next = bare(tokens[j]);
        // Step over git's own pre-command options, and the ones that take a value.
        if (GIT_VALUE_OPTIONS.has(next)) {
          if (next === '-c' && pushingAlias(bare(tokens[j + 1] ?? ''))) return true;
          j += 1;
          continue;
        }
        if (next.startsWith('-c') && pushingAlias(next.slice(2))) return true;
        if (next.startsWith('-')) continue;
        if (PUSH_VERBS.test(next)) return true;
        break; // some other subcommand entirely
      }
    }
    if (/(^|\/)gh$/.test(token) && ghPublishes(tokens.slice(i + 1).map(bare))) return true;
  }
  return writesPullRequest(command) || releases(command);
}

const PUSH_VERBS = /^(push|send-pack|http-push)$/;

/**
 * Git's global options that take their value as the NEXT token. Each one has to be stepped over
 * as a pair, or its value is read as the subcommand and the scan stops before the `push` that
 * follows: `git --namespace x push` was let through that way.
 */
const GIT_VALUE_OPTIONS = new Set([
  '-C',
  '-c',
  '--git-dir',
  '--work-tree',
  '--namespace',
  '--config-env',
  '--super-prefix',
  '--exec-path',
]);

/**
 * Does `-c alias.<name>=<value>` define an alias that pushes? `git -c alias.p=push p` names no
 * push verb where the subcommand goes, and the refusal text promises "not through an alias".
 * An alias defined in a config FILE beforehand is out of reach of a per-command guard.
 */
const pushingAlias = (value) =>
  /^alias\./i.test(value) && /(^|[=\s!])(push|send-pack|http-push)\b/.test(value);

/**
 * Does `gh <args>` publish? `pr create` and `pr merge` do, and so does `pr new`, gh's own alias
 * for `create`. `release create` publishes a release. `gh api` publishes when it WRITES to a
 * pull-request or release endpoint: any field flag, or a method other than GET, turns gh's
 * default GET into a write.
 */
function ghPublishes(args) {
  const [group, verb] = args;
  if (group === 'pr') return verb === 'create' || verb === 'new' || verb === 'merge';
  if (group === 'release') return verb === 'create';
  if (group !== 'api') return false;
  const rest = args.slice(1);
  if (!rest.some((a) => /(^|\/)(pulls|releases)(\/|\?|$)/.test(a))) return false;
  // gh's own rule: an explicit method wins, and otherwise any field or input makes it a POST.
  let method;
  rest.forEach((a, k) => {
    if (a === '-X' || a === '--method') method = rest[k + 1] ?? '';
    else if (a.startsWith('--method=')) method = a.slice('--method='.length);
    else if (/^-X./.test(a)) method = a.slice(2);
  });
  const fields = rest.some(
    (a) =>
      /^(-f|-F|--field|--raw-field|--input)$/.test(a) || /^(--field|--raw-field|--input)=/.test(a),
  );
  return method === undefined ? fields : !/^get$/i.test(method);
}

/**
 * Is `flag` present as a real, UNQUOTED token of this shell segment after `verb`?
 *
 * The dry-run leniency has to read the segment the way the shell will: `--title "fix -n flag"` is
 * one argument, and a `-n` inside it lends the invocation no dry run. So quoted spans are blanked
 * out first. If the verb itself was quoted it is not found, and that answers "no dry run" -- the
 * refusing direction, which is the right one to err in.
 */
function dryRunAfter(segment, verb, flags = ['-n', '--dry-run']) {
  const plain = segment
    .replace(/"(?:[^"\\]|\\.)*"|'[^']*'/g, ' _ ')
    .split(/\s+/)
    .filter(Boolean);
  const at = plain.indexOf(verb);
  return at >= 0 && plain.slice(at + 1).some((t) => flags.includes(t));
}

/**
 * Does this command line cut a release? A release commits, tags, pushes and creates a GitHub
 * release, so it is publishing by any reading -- and `-y` (or `--yes`) is the spelling that skips
 * its `/dev/tty` question. `hangar dev release`, the `release` script that runs it, and
 * semantic-release itself are each refused unless they are the dry run.
 */
/** Package-manager options that take the NEXT token as their value. */
const PM_VALUE_OPTIONS = new Set(['-C', '--dir', '--prefix', '--filter', '-F', '--workspace', '--cwd']);

/**
 * Where a program name is RUN rather than mentioned: the first word of the segment once `VAR=x`
 * and `env` are stepped over, or the first non-flag word after a runner (`npx`, `bunx`, `yarn`,
 * `pnpm exec|dlx`, `npm exec`). `npm view semantic-release time` and a `grep` for it name the
 * program without running it, and must pass.
 */
function commandPositions(tokens) {
  const at = new Set();
  let s = 0;
  while (s < tokens.length && (tokens[s] === 'env' || /^[A-Za-z_][A-Za-z0-9_]*=/.test(tokens[s]))) {
    s += 1;
  }
  at.add(s);
  for (let i = 0; i < tokens.length; i += 1) {
    const runner =
      /(^|\/)(npx|bunx|yarn)$/.test(tokens[i]) ||
      (/(^|\/)(pnpm|npm)$/.test(tokens[i]) && /^(exec|dlx)$/.test(tokens[i + 1] ?? ''));
    if (!runner) continue;
    let j = /^(exec|dlx)$/.test(tokens[i + 1] ?? '') ? i + 2 : i + 1;
    while (j < tokens.length && tokens[j].startsWith('-')) j += 1;
    at.add(j);
  }
  return at;
}

function releases(command) {
  const bare = (t) => t.replace(/^["']|["']$/g, '');
  for (const segment of command.split(/[;&|()`\n]+/)) {
    const tokens = segment.split(/\s+/).filter(Boolean).map(bare);
    const runs = commandPositions(tokens);
    for (let i = 0; i < tokens.length; i += 1) {
      const t = tokens[i];
      if (/(^|\/)semantic-release$/.test(t)) {
        if (runs.has(i) && !dryRunAfter(segment, tokens[i], ['--dry-run', '-d'])) return true;
        continue;
      }
      if (/(^|\/)(pnpm|npm|yarn)$/.test(t)) {
        // Step over the manager's own options first: `pnpm -C app release -y` named the script
        // after a directory, and the release ran while the check looked at `-C`.
        let k = i + 1;
        while (k < tokens.length && tokens[k].startsWith('-')) {
          k += PM_VALUE_OPTIONS.has(tokens[k]) ? 2 : 1;
        }
        if (tokens[k] === 'run' || tokens[k] === 'run-script') k += 1;
        // `-w` takes a value in npm and none in pnpm, so an explicit `run release` anywhere after
        // the manager counts as well.
        const named =
          tokens[k] === 'release' ||
          tokens.slice(i + 1).some((x, n, rest) => /^run(-script)?$/.test(x) && rest[n + 1] === 'release');
        if (named && !dryRunAfter(segment, 'release')) return true;
        continue;
      }
      if (!/(^|\/)hangar$/.test(t) && !/(^|\/)cli\.ts$/.test(t)) continue;
      let j = i + 1;
      while (j < tokens.length && tokens[j].startsWith('-')) j += tokens[j] === '--hangar' ? 2 : 1;
      if (tokens[j] === 'dev' && tokens[j + 1] === 'release' && !dryRunAfter(segment, 'release')) {
        return true;
      }
    }
  }
  return false;
}

/**
 * Does this command line open or rewrite a pull request, or push a branch, through hangar itself?
 *
 * `hangar push` is `git push` under another name, and `pr create`/`pr update` now push before
 * they write -- so all three are refused alike, and all three let their dry run through.
 *
 * `hangar pr create` and `pr update` default to the clone they are run in, which makes them the
 * obvious thing for a clone agent to reach for, and `-y` skips their `/dev/tty` confirmation --
 * so without this they were the one publishing path the guard left open. The dry run is let
 * through: it writes nothing to the forge, and `pr_create_preview` is pre-approved as a tool.
 * That test is per INVOCATION, which is why this splits into shell segments first:
 * `hangar pr create -y && ls -n` must not borrow the `-n` from `ls`.
 */
function writesPullRequest(command) {
  const bare = (t) => t.replace(/^["']|["']$/g, '');
  for (const segment of command.split(/[;&|()`\n]+/)) {
    const tokens = segment.split(/\s+/).filter(Boolean).map(bare);
    for (let i = 0; i < tokens.length; i += 1) {
      if (!/(^|\/)hangar$/.test(tokens[i]) && !/(^|\/)cli\.ts$/.test(tokens[i])) continue;
      let j = i + 1;
      // Step over the global flags, and `--hangar`'s value with its flag.
      while (j < tokens.length && tokens[j].startsWith('-')) j += tokens[j] === '--hangar' ? 2 : 1;
      let verb;
      if (tokens[j] === 'push') verb = 'push';
      else if (tokens[j] === 'pr' && (tokens[j + 1] === 'create' || tokens[j + 1] === 'update')) {
        verb = tokens[j + 1];
      } else continue;
      if (!dryRunAfter(segment, verb)) return true;
    }
  }
  return false;
}

/**
 * Does this command line run a `hangar key` action that acts?
 *
 * `key pr` (without `-n`), `key bg` and `key palette --entry` are what a palette entry runs, and
 * they are reached through the palette for a reason: `key pr` is `pr create`/`pr update` with
 * `-y`, so without this it is the way around `writesPullRequest`, and `key bg` starts a second
 * headless agent in a clone that already has one. Only the acting forms: the guard sees tokens,
 * so refusing every `hangar key` would also refuse a `grep` or a commit body that names one.
 * Per shell segment, like `writesPullRequest`, so a `-n` elsewhere on the line lends nothing.
 */
function actsThroughKey(command) {
  const bare = (t) => t.replace(/^["']|["']$/g, '');
  for (const segment of command.split(/[;&|()`\n]+/)) {
    const tokens = segment.split(/\s+/).filter(Boolean).map(bare);
    for (let i = 0; i < tokens.length; i += 1) {
      if (!/(^|\/)hangar$/.test(tokens[i]) && !/(^|\/)cli\.ts$/.test(tokens[i])) continue;
      let j = i + 1;
      while (j < tokens.length && tokens[j].startsWith('-')) j += tokens[j] === '--hangar' ? 2 : 1;
      if (tokens[j] !== 'key') continue;
      const action = tokens[j + 1];
      const rest = tokens.slice(j + 2);
      if (action === 'bg') return true;
      if (action === 'pr' && !dryRunAfter(segment, 'pr')) return true;
      if (action === 'palette' && rest.some((t) => t === '--entry' || t.startsWith('--entry='))) {
        return true;
      }
    }
  }
  return false;
}

/**
 * Does this command line invoke `hangar exec` anywhere in it?
 *
 * Token-based rather than a substring search, because both mistakes are real: `docker exec` and
 * a file called `exec.ts` must not be blocked, and `cd /x && hangar exec -- rm -rf .` must not
 * be missed. So it finds each token that names this CLI -- bare `hangar`, any path ending
 * `/hangar`, or a direct `node .../cli.ts` -- and asks whether the first thing that follows,
 * once the global `--hangar <path>` is stepped over, is the word `exec`.
 */
function invokesHangarExec(command) {
  // Split on shell separators as well as whitespace, so `a;hangar exec` is two invocations.
  const tokens = command.split(/[\s;&|()`]+/).filter(Boolean);
  for (let i = 0; i < tokens.length; i += 1) {
    const token = tokens[i].replace(/^["']|["']$/g, '');
    const isCli = /(^|\/)hangar$/.test(token) || /(^|\/)cli\.ts$/.test(token);
    if (!isCli) continue;
    for (let j = i + 1; j < tokens.length; j += 1) {
      const next = tokens[j].replace(/^["']|["']$/g, '');
      if (next === '--hangar') {
        j += 1; // its value
        continue;
      }
      if (next.startsWith('-')) continue; // any other global flag
      if (next === 'exec') return true;
      break; // a different subcommand: this invocation is not the one
    }
  }
  return false;
}
