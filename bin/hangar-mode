#!/bin/sh
# Launch Claude Code in one of this hangar's two modes. Reached as `hangar-ops` / `hangar-dev`.
#
# Why this is a script in bin/ and NOT a shell function in .envrc.hangar, which is where it
# started: direnv exports the ENVIRONMENT DIFF that evaluating a .envrc produces, and a shell
# function is not an environment variable. The helpers in .envrc.hangar (`hangar_use_node` and
# friends) survive only because they are CALLED while direnv is still evaluating that file --
# `type hangar_use_node` in an interactive shell inside this hangar answers "not found". PATH is
# an env var, so `PATH_add bin` genuinely reaches the shell, which makes bin/ the only mechanism
# that works here without editing anyone's ~/.zshrc. It also gets the per-hangar scoping for
# free, exactly like bin/hangar: the one on PATH belongs to the hangar you are standing in.
#
# A mode is three flags, plus a working directory for dev:
#   --settings <mode>.settings.json         the permission rules
#   --append-system-prompt-file <mode>.md   the remit
#   -n "hangar <mode>"                      so the mode shows in the prompt box, the terminal
#                                           title and the /resume picker
# Claude Code reads all three once, at startup, so nothing in the session can switch modes -- and
# passing --append-system-prompt-file turns the system-prompt snapshot off, so the remit is
# re-applied on every launch rather than frozen into the conversation. `hangar-ops --resume <id>`
# therefore resumes INTO operator mode; a bare `claude --resume` of the same session does not.
#
# The root CLAUDE.md loads in BOTH modes and cannot be suppressed: `--bare` skips CLAUDE.md
# discovery but makes auth strictly ANTHROPIC_API_KEY (this machine logs in with a subscription),
# and `--safe-mode` also disables the skills operator mode exists to use. Each mode file
# therefore CORRECTS that file rather than replacing it -- starting with "you are not in a
# clone", which it does not say and a hangar-root session has no other way to learn.
set -eu

mode="${1:?usage: hangar-mode <ops|dev> [claude args...]}"
shift

# Resolved from this script's own location and never from $PWD -- the rule bin/hangar follows,
# and the reason `hangar-dev` works from three directories down inside app/src/.
hangar="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"

case "$mode" in
    ops) dir="$hangar" ;;
    dev) dir="$hangar/app" ;;  # so app/CLAUDE.md loads on turn one, not lazily
    *)
        printf 'hangar-mode: unknown mode "%s" (expected ops or dev)\n' "$mode" >&2
        exit 2
        ;;
esac

prompt="$hangar/.claude/modes/$mode.md"
settings="$hangar/.claude/modes/$mode.settings.json"
for f in "$prompt" "$settings"; do
    if [ ! -r "$f" ]; then
        printf 'hangar-%s: missing %s\n' "$mode" "$f" >&2
        exit 1
    fi
done

# The status line (.claude/modes/statusline.sh) reads this when its argv does not arrive. Exported
# HERE and nowhere else: set from .envrc it would reach every shell in the hangar and a bare
# `claude` would wear a mode badge it does not have.
export HANGAR_MODE="$mode"

cd -- "$dir"
exec claude \
    --settings "$settings" \
    --append-system-prompt-file "$prompt" \
    -n "hangar $mode" \
    "$@"
