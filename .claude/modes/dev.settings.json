{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format)",
      "Bash(pnpm test)",
      "Bash(pnpm scan)",
      "Bash(pnpm golden)",
      "Bash(git diff --exit-code dev/golden/gated)",
      "Bash(hangar config schema --check)",
      "Bash(hangar colours sync -n)"
    ],
    "deny": [
      "Bash(hangar exec)",
      "Bash(hangar exec:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hangar-exec-guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "hangar-statusline dev"
  }
}
