{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hangar configuration",
  "description": "Configuration for one hangar: a directory holding a fleet of clones of one repo. Generated from the zod schema in src/config/schema.ts -- do not hand-edit. Cross-field rules (duplicate port roles, bases congruent mod step, tracker.baseUrl when tracker.kind is set) are enforced by the loader, not expressible here.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,23}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "default": "generic",
      "type": "string",
      "minLength": 1
    },
    "clones": {
      "default": {},
      "type": "object",
      "properties": {
        "prefix": {
          "default": "clone_",
          "type": "string",
          "minLength": 1,
          "pattern": "[^0-9]$"
        },
        "pad": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "forge": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bitbucketCloud",
            "none"
          ]
        },
        "originUrl": {
          "type": "string",
          "minLength": 1
        },
        "webBaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "tokenEnvKey": {
          "type": "string",
          "minLength": 1
        },
        "prCacheTtlSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "prDescriptionPrompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "originUrl"
      ],
      "additionalProperties": false
    },
    "tracker": {
      "default": {},
      "type": "object",
      "properties": {
        "kind": {
          "default": "none",
          "type": "string",
          "enum": [
            "jira",
            "none"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "issueUrlTemplate": {
          "default": "{baseUrl}/browse/{key}",
          "type": "string",
          "minLength": 1
        },
        "keyPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+$"
          }
        },
        "cache": {
          "default": {
            "ttlMinutes": 60,
            "bypassEnvKey": "HANGAR_TRACKER_NO_CACHE"
          },
          "type": "object",
          "properties": {
            "ttlMinutes": {
              "default": 60,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bypassEnvKey": {
              "default": "HANGAR_TRACKER_NO_CACHE",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "syncScript": {
          "type": "string",
          "minLength": 1
        },
        "namerScript": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "repo": {
      "default": {},
      "type": "object",
      "properties": {
        "appDir": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "envrcDirs": {
          "default": [
            "."
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cloneEnv": {
          "default": {
            "file": ".env.local",
            "vars": {}
          },
          "type": "object",
          "properties": {
            "file": {
              "default": ".env.local",
              "type": "string",
              "minLength": 1
            },
            "rootPathEnvKey": {
              "type": "string",
              "minLength": 1
            },
            "vars": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "symlinks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "skipIfDirMissing": {
                "default": true,
                "type": "boolean"
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "target",
              "why"
            ],
            "additionalProperties": false
          }
        },
        "install": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "manager": {
                "type": "string",
                "enum": [
                  "npm",
                  "pnpm",
                  "yarn",
                  "bun",
                  "deno",
                  "maven",
                  "gradle",
                  "bundler",
                  "pip",
                  "poetry",
                  "uv",
                  "cargo",
                  "go",
                  "composer"
                ]
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "nodeVersionFile": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "default": false,
                "type": "boolean"
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "why"
            ],
            "additionalProperties": false
          }
        },
        "portCheckCommand": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "ports": {
      "type": "object",
      "properties": {
        "step": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "envKey": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "base": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "default": "http://localhost:{port}",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "healthCheck": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "httpCurl"
                  },
                  "timeoutSeconds": {
                    "default": 3,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "path": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "envKey",
              "base",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "roles"
      ],
      "additionalProperties": false
    },
    "terminal": {
      "default": {},
      "type": "object",
      "properties": {
        "kind": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "iterm2",
            "apple-terminal",
            "konsole",
            "gnome-terminal",
            "none"
          ]
        },
        "placement": {
          "default": "tab",
          "type": "string",
          "enum": [
            "tab",
            "window"
          ]
        },
        "colour": {
          "default": {},
          "type": "object",
          "properties": {
            "chrome": {
              "default": true,
              "type": "boolean"
            },
            "title": {
              "default": true,
              "type": "boolean"
            },
            "env": {
              "default": true,
              "type": "boolean"
            },
            "tint": {
              "default": 0.16,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "tabs": {
          "default": [
            {
              "role": "claude",
              "dir": ".",
              "command": "claude"
            }
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "dir": {
                "default": ".",
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "editor": {
      "default": {},
      "type": "object",
      "properties": {
        "kinds": {
          "default": [
            "vscode"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode",
              "cursor",
              "windsurf",
              "vscodium",
              "code-insiders",
              "positron",
              "trae",
              "jetbrains",
              "zed",
              "emacs",
              "vim",
              "xcode",
              "eclipse"
            ]
          }
        },
        "jetbrains": {
          "default": {},
          "type": "object",
          "properties": {
            "product": {
              "default": "idea",
              "type": "string",
              "enum": [
                "idea",
                "webstorm",
                "pycharm",
                "phpstorm",
                "goland",
                "rubymine",
                "clion",
                "rider",
                "datagrip",
                "rustrover",
                "aqua",
                "android-studio"
              ]
            },
            "launcher": {
              "default": "",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "vim": {
          "default": {},
          "type": "object",
          "properties": {
            "command": {
              "default": "",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "eclipse": {
          "default": {},
          "type": "object",
          "properties": {
            "launcher": {
              "default": "",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "workspaceFileName": {
          "default": "{id}_{index2}.code-workspace",
          "type": "string",
          "minLength": 1
        },
        "workspaceFolderLabel": {
          "default": "{index}: {id}",
          "type": "string",
          "minLength": 1
        },
        "workspaceDirs": {
          "default": [
            "."
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootPathKeys": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "default": {},
      "type": "object",
      "properties": {
        "file": {
          "default": ".env.shared",
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "default": "600",
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        },
        "variables": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "default": {},
      "type": "object",
      "properties": {
        "hues": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*$"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "name",
              "hex"
            ],
            "additionalProperties": false
          }
        },
        "rotate": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "forge",
    "ports"
  ],
  "additionalProperties": false
}
