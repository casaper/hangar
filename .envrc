# direnv config for the HANGAR ROOT (~/code/dvb_gn) -- the orchestration CLI, not the app.
#
# This does NOT reach the clones: direnv loads the nearest .envrc only, and every clone has
# its own tracked one. So nothing here is inherited downward -- each clone repeats the
# `PATH_add` it needs in its own untracked `.envrc.private`, which `hangar add-clone` writes
# and `hangar doctor --fix` repairs.
#
# Never create a package.json or node_modules at this level. This directory is an ancestor
# of every clone, and Node resolves a file's module type from the nearest package.json
# walking up -- a `"type": "module"` here once flipped every clone's .claude/hooks/*.js to
# ESM and broke them all at session start. The CLI's package lives in app/.

source_env .envrc.hangar

# GNU userland ahead of BSD (macOS only; no-op elsewhere).
hangar_use_gnu

# This hangar's own `hangar` binary. Scoping it with direnv rather than installing it
# globally is what lets several hangars each have a `hangar` of their own: the one on PATH
# is always the one belonging to the hangar you are standing in.
PATH_add bin

# Node for the CLI itself, pinned by .nvmrc, plus a pnpm that tracks
# app/package.json's `packageManager` field.
hangar_use_node .nvmrc
hangar_use_pnpm .hangar/pnpm-bin

# The CLI's dev binaries (tsc, eslint, prettier) -- its package is in app/, so its
# node_modules is too.
PATH_add app/node_modules/.bin
