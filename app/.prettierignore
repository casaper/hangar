node_modules/
pnpm-lock.yaml

# Untracked per-machine plugin state (the Remember plugin's buffer). Gitignored, so it was
# invisible until it appeared mid-session and failed `pnpm format:check` -- the gate this
# package's CLAUDE.md tells every developer to run.
.remember/

# Generated by `pnpm golden` -- byte-for-byte captures of what this hangar would write.
# Reformatting them would rewrite the very bytes the diff is comparing, and the JSON and
# Markdown in here is produced by the builders under test, not authored here.
dev/golden/

# husky internals, generated by `pnpm hooks`. The user hooks beside them are shell, which
# prettier does not format either.
.husky/

# Developer mode's own plan files. Gitignored at the hangar root (`app/.claude/plans/`), which
# does not reach prettier -- so every plan a `hangar claude -m dev` session writes turned
# `pnpm format:check` red, in a directory the developer never edits by hand. Same failure as
# `.remember/` above, and the same fix.
.claude/plans/
