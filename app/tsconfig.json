{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // No build step: Node 24 strips the types at load time, so `bin/hangar` runs src/cli.ts
    // directly. `erasableSyntaxOnly` is what keeps that honest -- it rejects enums,
    // parameter properties and namespaces, which the stripper cannot handle.
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    // An unused parameter is a promise the code does not keep: nine `hangar` parameters had
    // outlived every use, each one reading as "this answer depends on the hangar" when it did not.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "dev/**/*.ts",
    "eslint.config.ts",
    "changelog.preset.ts",
    "types/**/*.d.ts"
  ]
}
