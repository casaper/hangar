{
  "permissions": {
    "allow": [
      "Read(/Users/someone/code/dvb_gn/**)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" --max-time 3 http://localhost:6106)"
    ],
    "deny": [
      "Read(/Users/someone/code/dvb_gn/.env.shared)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/someone/.claude/dvb_gn-clone-statusline.sh"
  },
  "autoMemoryDirectory": "/Users/someone/.claude/dvb_gn-memory",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/someone/code/dvb_gn/bin/hangar --hangar /Users/someone/code/dvb_gn jira hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/someone/code/dvb_gn/bin/hangar --hangar /Users/someone/code/dvb_gn plans collect --quiet",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/someone/code/dvb_gn/bin/hangar --hangar /Users/someone/code/dvb_gn tmp merge --quiet",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "theme": "custom:dvb_gn-clone-02-yellow"
}
