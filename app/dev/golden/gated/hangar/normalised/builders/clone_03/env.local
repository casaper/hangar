# Per-clone values ONLY. Secrets shared by every clone live one level up in
# ~/code/dvb_gn/.env.shared, loaded by this clone's .envrc.private before this file
# (so anything set here still overrides the shared value).
#
# Ports must differ per clone: two clones sharing a dev server means a test run in one
# silently verifies the other one's code. Check with `node dev/ports.mjs`.
#
# Generated by `hangar add-clone` from the clone index (3); repair a drifted
# value with `hangar doctor --fix` rather than by hand.

PROJECT_GIT_ROOT_PATH='%HANGAR%/clone_03'

NG_DEV_SERVER_PORT=4400
STORYBOOK_DEV_SERVER_PORT=6206
PLAYWRIGHT_REPORT_PORT=9523
