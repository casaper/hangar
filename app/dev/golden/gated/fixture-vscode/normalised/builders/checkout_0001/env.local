# Per-clone values ONLY. Secrets shared by every clone live one level up in
# %HANGAR%/.env.vsfix-shared, loaded by this clone's .envrc.private before this file
# (so anything set here still overrides the shared value).
#
# Ports must differ per clone: two clones sharing a dev server means a test run in one
# silently verifies the other one's code. Check with `pnpm --dir web run ports:print`.
#
# Generated by `hangar add-clone` from the clone index (1); repair a drifted
# value with `hangar doctor --fix` rather than by hand.

VSFIX_CHECKOUT_ROOT='%HANGAR%/checkout_0001'

VSFIX_WEB_PORT=4200
VSFIX_STORYBOOK_PORT=6006
VSFIX_E2E_REPORT_PORT=9323
NEXT_PUBLIC_APP_NAME=vscode fixture 1
COMPOSE_PROJECT_NAME=vsfix_0001
REDIS_NAMESPACE=checkout_0001
