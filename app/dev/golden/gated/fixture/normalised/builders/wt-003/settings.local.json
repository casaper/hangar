{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(curl -s -o /dev/null --max-time 3 http://localhost:9999)",
      "Read(%HANGAR%/**)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" --max-time 7 http://localhost:3237/ready)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(%HANGAR%/.env.fixture-shared)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "%HANGAR%/bin/hangar --hangar %HANGAR% plans collect --quiet",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "%HANGAR%/bin/hangar --hangar %HANGAR% tmp merge --quiet",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "%HANGAR%/bin/hangar --hangar %HANGAR% jira hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "%HANGAR%/bin/hangar-exec-guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "custom:wt-clone-003-green",
  "statusLine": {
    "type": "command",
    "command": "%HOME%/.claude/wt-clone-statusline.sh"
  },
  "autoMemoryDirectory": "%HOME%/.claude/wt-memory"
}
