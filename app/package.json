    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.7.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "18.3.0",
    "jiti": "2.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0"
