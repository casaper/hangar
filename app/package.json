{
  "name": "hangar",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "Hangar -- orchestrates a fleet of full clones of one repo for parallel Claude Code sessions.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "hangar": "node src/cli.ts",
    "golden": "sh dev/golden.sh",
    "scan": "pnpm scan:secrets && pnpm scan:literals",
    "scan:secrets": "sh dev/scan-secrets.sh",
    "scan:literals": "sh dev/scrub-check.sh",
    "commitlint": "commitlint",
    "changelog": "sh dev/changelog.sh",
    "release": "node src/cli.ts dev release",
    "hooks": "cd .. && husky app/.husky",
    "prepare": "cd .. && husky app/.husky"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "picocolors": "^1.1.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "^24.7.2",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "18.3.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "prettier": "^3.6.2",
    "semantic-release": "25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
